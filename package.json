{
  "name": "telegram-hygiene",
  "version": "0.1.0",
  "description": "Manage your Telegram subscriptions and chats across multiple accounts",
  "main": "out/main/index.js",
  "author": "Oleg Tretyak",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "launch": "npm run build && npm run pack && node scripts/sign-and-launch.js"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.1",
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.13.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.5.4",
    "telegram": "^2.26.22",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "com.olegtretyak.telegramhygiene",
    "productName": "Telegram Hygiene",
    "directories": { "buildResources": "resources" },
    "mac": {
      "target": [{ "target": "dir" }],
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "files": ["out/**/*", "node_modules/**/*", "package.json"],
    "asarUnpack": ["node_modules/sql.js/dist/**/*"],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js"
  }
}
